---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AIRPORTS } from '../data/airports';
import { FAQ_CATEGORIES, FAQ_ITEMS } from '../data/faqs';

const siteUrl = 'https://jichang-clash.xyz';
---

<Layout
  title="🗺️ 网站地图 (Sitemap) - 机场clash 全站索引导航与搜索引擎抓取中心"
  description={`机场clash (jichang-clash.xyz) 全站网站地图，收录 ${AIRPORTS.length} 家精选机场详细评测专页、${FAQ_ITEMS.length} 篇常见问题与排错实操教程以及客户端下载配置指南，提供 XML 与 HTML 双重索引。`}
  keywords="网站地图, 机场clash地图, Sitemap, 全站索引, 机场评测目录, Clash教程目录, FAQ知识库目录"
  canonicalURL="https://jichang-clash.xyz/sitemap"
>
  <Header slot="header" />

  <main class="py-8 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- 面包屑导航 -->
    <nav class="flex items-center space-x-2 text-xs text-slate-500 mb-6 font-mono">
      <a href="/" class="hover:text-indigo-600 transition-colors">首页</a>
      <span>/</span>
      <span class="text-indigo-600 font-semibold">网站地图 (Sitemap)</span>
    </nav>

    <!-- 顶部 Banner -->
    <header class="mb-10 pb-8 border-b border-slate-200">
      <div class="inline-flex items-center space-x-1.5 text-xs font-semibold px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 mb-2 font-mono">
        <span>HTML & XML SITEMAP DIRECTORY</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        网站地图 (Sitemap) 全站索引中心
      </h1>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        提供本站全量页面结构索引，帮助访客快速直达所需页面，并协助搜索引擎蜘蛛抓取全站内容。
      </p>

      <!-- 快速协议文件入口 -->
      <div class="flex flex-wrap items-center gap-3 mt-4">
        <a
          href="/sitemap.xml"
          target="_blank"
          class="inline-flex items-center space-x-1.5 text-xs font-mono font-bold px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 transition-colors"
        >
          <span>📄 XML 格式站点地图 (sitemap.xml)</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <a
          href="/robots.txt"
          target="_blank"
          class="inline-flex items-center space-x-1.5 text-xs font-mono font-bold px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 transition-colors"
        >
          <span>🤖 爬虫协议规则 (robots.txt)</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </header>

    <!-- 快捷分类跳转锚点 -->
    <div class="flex flex-wrap items-center gap-2 mb-10 pb-4 border-b border-slate-100">
      <span class="text-xs font-bold text-slate-400 font-mono">快速定位：</span>
      <a href="#core-pages" class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">核心频道 (6)</a>
      <a href="#airport-reviews" class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">机场评测专页 ({AIRPORTS.length})</a>
      <a href="#faq-articles" class="text-xs px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">FAQ 深度解答 ({FAQ_ITEMS.length})</a>
    </div>

    <!-- 模块 1：核心主频道 -->
    <section id="core-pages" class="mb-12 scroll-mt-20">
      <h2 class="text-xl font-bold text-slate-900 mb-4 flex items-center space-x-2">
        <span class="w-2.5 h-5 bg-indigo-600 rounded-full inline-block"></span>
        <span>一、核心频道与枢纽中心</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/" class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-sm transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center justify-between">
            <span>🏠 网站首页</span>
            <span class="text-[11px] text-slate-400 font-mono">/</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">2026 最新精选机场推荐总榜与核心主推专区</p>
        </a>

        <a href="/recommendations" class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-sm transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center justify-between">
            <span>🔥 热门机场推荐</span>
            <span class="text-[11px] text-slate-400 font-mono">/recommendations</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">全网 35 款优质高速稳定机场聚合选购榜单</p>
        </a>

        <a href="/comparison" class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-sm transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center justify-between">
            <span>📊 参数横向对比大表</span>
            <span class="text-[11px] text-slate-400 font-mono">/comparison</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">全量价格、专线类型、流媒体与测速多维大比拼</p>
        </a>

        <a href="/tutorials" class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-sm transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center justify-between">
            <span>📖 Clash 教程中心</span>
            <span class="text-[11px] text-slate-400 font-mono">/tutorials</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">全平台客户端下载与订阅导入保姆级指南</p>
        </a>

        <a href="/tutorials/clash-verge" class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-sm transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center justify-between">
            <span>🚀 Clash Verge Rev 专页</span>
            <span class="text-[11px] text-slate-400 font-mono">/tutorials/clash-verge</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">Windows/Mac 最新开源客户端一键配置全教程</p>
        </a>

        <a href="/faq" class="p-4 rounded-2xl bg-white border border-slate-200 hover:border-indigo-400 hover:shadow-sm transition-all group">
          <div class="font-bold text-slate-900 group-hover:text-indigo-600 transition-colors flex items-center justify-between">
            <span>💡 常见问题与排错知识库</span>
            <span class="text-[11px] text-slate-400 font-mono">/faq</span>
          </div>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">77 篇权威深度技术解答与独立疑难专页</p>
        </a>
      </div>
    </section>

    <!-- 模块 2：机场品牌详细评测专页 -->
    <section id="airport-reviews" class="mb-12 scroll-mt-20">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-slate-900 flex items-center space-x-2">
          <span class="w-2.5 h-5 bg-sky-500 rounded-full inline-block"></span>
          <span>二、机场品牌评测独立专页 ({AIRPORTS.length} 家)</span>
        </h2>
        <span class="text-xs text-slate-500 font-mono">URL 前缀: /airports/[id]</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5">
        {AIRPORTS.map((airport, idx) => (
          <a
            href={`/airports/${airport.id}`}
            class="p-3 rounded-xl bg-white border border-slate-200 hover:border-indigo-300 hover:shadow-xs transition-all flex items-center space-x-2.5 group"
          >
            {airport.logo ? (
              <img
                src={airport.logo}
                alt={airport.name}
                class="w-7 h-7 rounded-lg object-contain bg-slate-50 border border-slate-100 flex-shrink-0"
              />
            ) : (
              <div class="w-7 h-7 rounded-lg bg-indigo-50 text-indigo-700 font-bold text-xs flex items-center justify-center flex-shrink-0 font-mono">
                {airport.name.slice(0, 1)}
              </div>
            )}
            <div class="min-w-0 flex-1">
              <div class="text-xs font-bold text-slate-800 group-hover:text-indigo-600 transition-colors truncate">
                {airport.name}
              </div>
              <div class="text-[10px] text-slate-400 truncate font-mono">
                {airport.lines !== '-' ? airport.lines : '专线加速'}
              </div>
            </div>
            {airport.featured && (
              <span class="text-[9px] px-1.5 py-0.2 rounded bg-amber-50 text-amber-700 border border-amber-200 font-mono">
                推荐
              </span>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- 模块 3：FAQ 知识库 77 篇独立问答专页 -->
    <section id="faq-articles" class="mb-12 scroll-mt-20">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-slate-900 flex items-center space-x-2">
          <span class="w-2.5 h-5 bg-emerald-500 rounded-full inline-block"></span>
          <span>三、常见问题解答与实操专页 ({FAQ_ITEMS.length} 篇)</span>
        </h2>
        <span class="text-xs text-slate-500 font-mono">URL 前缀: /faq/[slug]</span>
      </div>

      <div class="space-y-6">
        {FAQ_CATEGORIES.map(cat => (
          <div class="bg-white p-5 rounded-2xl border border-slate-200">
            <h3 class="text-sm font-bold text-slate-900 mb-3 pb-2 border-b border-slate-100 flex items-center justify-between">
              <span class="flex items-center space-x-1.5">
                <span>{cat.icon}</span>
                <span>{cat.category}</span>
              </span>
              <span class="text-xs text-slate-400 font-mono">{cat.items.length} 篇</span>
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {cat.items.map(item => (
                <a
                  href={`/faq/${item.slug}`}
                  class="text-xs text-slate-600 hover:text-indigo-600 hover:bg-slate-50 p-2 rounded-lg transition-colors flex items-start space-x-2 group"
                >
                  <span class="text-indigo-400 group-hover:text-indigo-600 mt-0.5">•</span>
                  <span class="leading-relaxed">{item.question}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</Layout>
