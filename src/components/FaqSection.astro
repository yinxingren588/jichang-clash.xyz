---
import { FAQS } from '../data/airports';
import { FAQ_ITEMS } from '../data/faqs';
---

<section id="faq" class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
  <div class="text-center mb-12">
    <div class="inline-block text-xs font-semibold px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 mb-3 font-mono">
      FREQUENTLY ASKED QUESTIONS
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
      新手使用与选购常见疑问解答 (FAQ)
    </h2>
    <p class="text-sm sm:text-base text-slate-600 mt-2">
      解决您在选择机场、导入订阅与翻墙过程中的核心顾虑
    </p>
  </div>

  <div class="space-y-4">
    {FAQS.map((faq: any, idx: number) => (
      <details class="group rounded-2xl bg-white border border-slate-200 p-5 open:bg-indigo-50/20 open:border-indigo-300 shadow-sm transition-all">
        <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-base select-none list-none">
          <span class="flex items-center space-x-3">
            <span class="text-indigo-600 font-mono text-sm">Q{idx + 1}.</span>
            <span>{faq.q}</span>
          </span>
          <span class="ml-4 flex-shrink-0 transition-transform duration-200 group-open:rotate-180 text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </span>
        </summary>
        <div class="mt-4 text-sm text-slate-600 leading-relaxed pl-8 border-l-2 border-indigo-400">
          <p>{faq.a}</p>
          {faq.slug && (
            <div class="mt-3 pt-2">
              <a
                href={`/faq/${faq.slug}`}
                class="inline-flex items-center space-x-1.5 text-xs font-semibold text-indigo-600 hover:text-indigo-700 bg-indigo-50 hover:bg-indigo-100/80 px-3 py-1.5 rounded-lg transition-colors"
              >
                <span>查看该问题的完整独立解答与排错教程</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </a>
            </div>
          )}
        </div>
      </details>
    ))}
  </div>

  <div class="mt-8 text-center">
    <a
      href="/faq"
      class="inline-flex items-center space-x-2 text-sm font-bold text-indigo-600 hover:text-indigo-500 hover:underline"
    >
      <span>浏览知识库全部 {FAQ_ITEMS.length} 项权威实操解答与独立专页</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </div>
</section>
