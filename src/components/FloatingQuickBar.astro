---
// src/components/FloatingQuickBar.astro
// 可移动快捷栏组件：最上方放置 Clash 独家合作机场（隐形人）与全站快捷导航
import { FAQ_ITEMS } from '../data/faqs';
---

<div
  id="floating-quick-bar"
  class="fixed right-3 sm:right-6 top-24 z-50 select-none transition-shadow duration-200"
  style="touch-action: none;"
>
  <!-- 展开状态的主卡片面板 -->
  <div
    id="quick-bar-content"
    class="w-64 sm:w-72 rounded-2xl bg-white/95 backdrop-blur-md border-2 border-indigo-500/30 shadow-2xl shadow-indigo-500/15 overflow-hidden flex flex-col"
  >
    <!-- 拖拽操作手柄栏 (Drag Handle Header) -->
    <div
      id="quick-bar-drag-handle"
      class="px-3.5 py-2 bg-gradient-to-r from-indigo-600 via-indigo-700 to-indigo-800 text-white flex items-center justify-between cursor-grab active:cursor-grabbing border-b border-indigo-400/30"
      title="按住鼠标左键可拖拽移动位置"
    >
      <div class="flex items-center space-x-1.5 text-xs font-bold tracking-wide">
        <!-- 拖动小图标 -->
        <svg class="w-3.5 h-3.5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8h16M4 16h16" />
        </svg>
        <span>快捷工具栏</span>
        <span class="text-[10px] font-mono text-indigo-200 bg-white/15 px-1.5 py-0.2 rounded font-normal">可拖动</span>
      </div>
      <div class="flex items-center space-x-1">
        <!-- 最小化按钮 -->
        <button
          type="button"
          id="btn-quick-bar-minimize"
          class="p-1 rounded-md hover:bg-white/20 text-indigo-100 hover:text-white transition-colors"
          title="最小化快捷栏"
          aria-label="最小化快捷栏"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
    </div>

    <!-- 快捷栏核心内容区 -->
    <div class="p-3.5 space-y-3 max-h-[80vh] overflow-y-auto">
      <!-- 👑 最上方：Clash 独家合作机场（隐形人） -->
      <div class="rounded-xl p-3 bg-gradient-to-br from-indigo-50 via-white to-sky-50 border-2 border-indigo-500/40 shadow-xs relative">
        <!-- 独家合作皇冠徽章 -->
        <div class="flex items-center justify-between mb-2">
          <span class="inline-flex items-center space-x-1 text-[11px] font-extrabold px-2 py-0.5 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 text-white shadow-xs">
            <span>👑</span>
            <span>Clash 独家合作机场</span>
          </span>
          <span class="text-xs font-mono font-black text-amber-600 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded">
            ★ 9.9
          </span>
        </div>

        <!-- 品牌信息与 Logo -->
        <div class="flex items-center space-x-2.5 mb-2">
          <img
            src="/images/logos/invisible.jpg"
            alt="隐形人 Logo"
            class="w-9 h-9 rounded-xl object-cover border border-indigo-200 shadow-xs flex-shrink-0"
          />
          <div class="flex-1 min-w-0">
            <h4 class="text-sm font-black text-slate-900 truncate flex items-center gap-1">
              <span>隐形人</span>
              <span class="text-[10px] text-indigo-700 bg-indigo-100 px-1.5 py-0.2 rounded font-normal">全IEPL专线</span>
            </h4>
            <p class="text-[11px] text-slate-500 truncate">
              晚高峰 0.8% 极低丢包 · 秒开 4K/8K
            </p>
          </div>
        </div>

        <!-- 支付与专属优惠 -->
        <div class="text-[11px] text-slate-600 mb-2 space-y-1 bg-white/70 p-1.5 rounded-lg border border-slate-100">
          <div class="flex items-center text-emerald-700 font-medium">
            <span class="mr-1">💳</span>
            <span>支持微信 / 支付宝 / USDT 即时开通</span>
          </div>
          <div class="flex items-center text-indigo-700 font-medium">
            <span class="mr-1">🎁</span>
            <span>8折码: <code class="font-bold font-mono bg-indigo-100 px-1 rounded">yxr888</code> (立减20%)</span>
          </div>
        </div>

        <!-- 操作按钮组合 -->
        <div class="grid grid-cols-2 gap-1.5 pt-1">
          <a
            href="https://varnexa.invisibleaff.com/#/?code=JF4seZUy"
            target="_blank"
            rel="noopener noreferrer"
            class="py-1.5 px-2 text-center rounded-lg bg-gradient-to-r from-indigo-600 to-indigo-700 hover:from-indigo-500 hover:to-indigo-600 text-white font-bold text-xs shadow-xs transition-all active:scale-95 flex items-center justify-center space-x-1"
          >
            <span>直达官网</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a
            href="/airports/invisible"
            class="py-1.5 px-2 text-center rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-bold text-xs transition-all active:scale-95 flex items-center justify-center"
          >
            <span>查看评测</span>
          </a>
        </div>
      </div>

      <!-- 快速导航专区 -->
      <div class="space-y-1">
        <div class="text-[11px] font-bold text-slate-400 font-mono uppercase tracking-wider px-1">
          QUICK ACCESS · 快捷入口
        </div>
        <div class="grid grid-cols-2 gap-1.5 text-xs font-semibold">
          <a
            href="/"
            class="p-2 rounded-xl bg-slate-50 hover:bg-indigo-50 text-slate-700 hover:text-indigo-600 border border-slate-200/80 transition-colors flex items-center space-x-1.5"
          >
            <span>🏠</span>
            <span>网站首页</span>
          </a>
          <a
            href="/recommendations"
            class="p-2 rounded-xl bg-slate-50 hover:bg-indigo-50 text-slate-700 hover:text-indigo-600 border border-slate-200/80 transition-colors flex items-center space-x-1.5"
          >
            <span>🔥</span>
            <span>精选推荐</span>
          </a>
          <a
            href="/comparison"
            class="p-2 rounded-xl bg-slate-50 hover:bg-indigo-50 text-slate-700 hover:text-indigo-600 border border-slate-200/80 transition-colors flex items-center space-x-1.5"
          >
            <span>📊</span>
            <span>机场对比</span>
          </a>
          <a
            href="/tutorials"
            class="p-2 rounded-xl bg-slate-50 hover:bg-indigo-50 text-slate-700 hover:text-indigo-600 border border-slate-200/80 transition-colors flex items-center space-x-1.5"
          >
            <span>📖</span>
            <span>Clash教程</span>
          </a>
          <a
            href="/faq"
            class="col-span-2 p-2 rounded-xl bg-slate-50 hover:bg-indigo-50 text-slate-700 hover:text-indigo-600 border border-slate-200/80 transition-colors flex items-center justify-between"
          >
            <span class="flex items-center space-x-1.5">
              <span>💡</span>
              <span>常见问题排错 ({FAQ_ITEMS.length}篇深度专页)</span>
            </span>
            <span class="text-[10px] text-indigo-600 font-mono bg-indigo-50 px-1.5 py-0.2 rounded border border-indigo-200">
              NEW
            </span>
          </a>
        </div>
      </div>

      <!-- 快捷小工具：一键回到顶部 -->
      <div class="pt-1 border-t border-slate-100 flex items-center justify-between text-xs">
        <button
          type="button"
          id="btn-scroll-to-top"
          class="w-full py-1.5 px-3 rounded-lg bg-slate-100 hover:bg-indigo-100/70 text-slate-600 hover:text-indigo-700 font-semibold transition-colors flex items-center justify-center space-x-1"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
          <span>回到页面顶部</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 最小化状态下的浮动胶囊按钮 -->
  <button
    type="button"
    id="quick-bar-minimized-pill"
    class="hidden px-3.5 py-2 rounded-full bg-gradient-to-r from-indigo-600 to-indigo-800 text-white font-bold text-xs shadow-xl border border-indigo-300/40 hover:scale-105 active:scale-95 transition-all items-center space-x-1.5 cursor-pointer"
    title="点击展开快捷栏"
  >
    <span>👑</span>
    <span>Clash 独家合作 · 快捷导航</span>
    <svg class="w-3.5 h-3.5 text-indigo-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
    </svg>
  </button>
</div>

<script>
  // 客户端原生拖拽与折叠逻辑
  const bar = document.getElementById('floating-quick-bar');
  const handle = document.getElementById('quick-bar-drag-handle');
  const content = document.getElementById('quick-bar-content');
  const pill = document.getElementById('quick-bar-minimized-pill');
  const btnMin = document.getElementById('btn-quick-bar-minimize');
  const btnScrollTop = document.getElementById('btn-scroll-to-top');

  if (bar && handle && content && pill && btnMin) {
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let startLeft = 0;
    let startTop = 0;
    let hasMoved = false;

    // 拖拽初始化
    const onStart = (clientX: number, clientY: number) => {
      isDragging = true;
      hasMoved = false;
      const rect = bar.getBoundingClientRect();
      startX = clientX;
      startY = clientY;
      startLeft = rect.left;
      startTop = rect.top;
      handle.style.cursor = 'grabbing';
      bar.style.transition = 'none';
    };

    const onMove = (clientX: number, clientY: number) => {
      if (!isDragging) return;
      const deltaX = clientX - startX;
      const deltaY = clientY - startY;

      if (Math.abs(deltaX) > 3 || Math.abs(deltaY) > 3) {
        hasMoved = true;
      }

      let newLeft = startLeft + deltaX;
      let newTop = startTop + deltaY;

      // 屏幕边界碰撞检测
      const maxLeft = window.innerWidth - bar.offsetWidth - 8;
      const maxTop = window.innerHeight - bar.offsetHeight - 8;

      newLeft = Math.max(8, Math.min(maxLeft, newLeft));
      newTop = Math.max(8, Math.min(maxTop, newTop));

      bar.style.left = `${newLeft}px`;
      bar.style.top = `${newTop}px`;
      bar.style.right = 'auto';
      bar.style.bottom = 'auto';
    };

    const onEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      handle.style.cursor = 'grab';
    };

    // 鼠标事件
    handle.addEventListener('mousedown', (e: MouseEvent) => {
      // 避免点击按钮触发拖动
      if ((e.target as HTMLElement).closest('button')) return;
      onStart(e.clientX, e.clientY);
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e: MouseEvent) => {
      onMove(e.clientX, e.clientY);
    });

    window.addEventListener('mouseup', onEnd);

    // 触控事件 (移动设备)
    handle.addEventListener('touchstart', (e: TouchEvent) => {
      if ((e.target as HTMLElement).closest('button')) return;
      if (e.touches.length === 1) {
        onStart(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: false });

    window.addEventListener('touchmove', (e: TouchEvent) => {
      if (e.touches.length === 1) {
        onMove(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: false });

    window.addEventListener('touchend', onEnd);

    // 最小化 / 展开切换
    btnMin.addEventListener('click', (e) => {
      e.stopPropagation();
      content.classList.add('hidden');
      pill.classList.remove('hidden');
      pill.classList.add('flex');
    });

    pill.addEventListener('click', () => {
      pill.classList.add('hidden');
      pill.classList.remove('flex');
      content.classList.remove('hidden');
    });

    // 回到顶部功能
    if (btnScrollTop) {
      btnScrollTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  }
</script>
