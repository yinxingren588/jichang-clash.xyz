---
import type { Airport } from '../data/airports';

interface Props {
  airport: Airport;
  index: number;
}

const { airport, index } = Astro.props;

const badgeColors = {
  indigo: 'bg-indigo-50 text-indigo-700 border-indigo-200',
  emerald: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  amber: 'bg-amber-50 text-amber-700 border-amber-200',
  rose: 'bg-rose-50 text-rose-700 border-rose-200',
  sky: 'bg-sky-50 text-sky-700 border-sky-200',
};

const currentBadgeColor = airport.badgeColor ? badgeColors[airport.badgeColor] : badgeColors.indigo;

// 多维度关键词分类计算
const categories = ['all'];

// 1. iplc (专线)
if (airport.category === 'iplc' || (airport.lines && (airport.lines.includes('专线') || airport.lines.includes('IPLC') || airport.lines.includes('IEPL')))) {
  categories.push('iplc');
}

// 2. cost-effective (高性价比)
const costEffectiveIds = ['invisible', 'kosing', 'sujie', 'kuaili', 'liulianyun', 'shandianshu', 'huanqiuti', 'shenxing', 'yunjiexian', 'twilight', 'flycat', 'lingdong', 'flashleap', 'kuajie', 'ermaoyun', 'onefly', 'wavenet', 'firefly'];
if (costEffectiveIds.includes(airport.id) || (airport.price && (airport.price.includes('¥7') || airport.price.includes('¥8') || airport.price.includes('¥10') || airport.price.includes('¥15') || airport.price.includes('¥19') || airport.price.includes('折合') || airport.price.includes('特惠')))) {
  categories.push('cost-effective');
}

// 3. streaming (流媒体大流量)
const streamingIds = ['invisible', 'dalaocloud', 'kosing', 'sujie', 'kuaili', 'liulianyun', 'shandianshu', 'huanqiuti', 'shenxing', 'yunjiexian', 'breezenet', 'flycat', 'laddercloud', 'lightspeed', 'civet', 'edgenova', 'stardream', 'flyv'];
if (streamingIds.includes(airport.id) || (airport.traffic && (airport.traffic.includes('TB') || airport.traffic.includes('1.0') || airport.traffic.includes('500G') || airport.traffic.includes('800G') || airport.traffic.includes('1000G') || airport.traffic.includes('1.2TB') || airport.traffic.includes('1.6TB')))) {
  categories.push('streaming');
}

// 4. monthly (月付尝鲜)
const monthlyIds = ['invisible', 'kosing', 'sujie', 'kuaili', 'liulianyun', 'shandianshu', 'huanqiuti', 'shenxing', 'yunjiexian', 'dalaocloud', 'twilight', 'flycat', 'flyv', 'lingdong', 'flashleap', 'kuajie', 'ermaoyun', 'onefly'];
if (monthlyIds.includes(airport.id) || (airport.price && (airport.price.includes('月付') || airport.price.includes('/月')))) {
  categories.push('monthly');
}

// 5. onetime (不限时按量)
const onetimeIds = ['invisible', 'kosing', 'liulianyun', 'huanqiuti', 'dalaocloud', 'laddercloud', 'flycat', 'civet', 'worryfree'];
if (onetimeIds.includes(airport.id) || (airport.traffic && (airport.traffic.includes('买断') || airport.traffic.includes('永久') || airport.traffic.includes('不过期') || airport.traffic.includes('重置')))) {
  categories.push('onetime');
}

// 6. dual-isp (原生双ISP)
const dualIspIds = ['shandianshu', 'invisible', 'kosing', 'sujie', 'kuaili', 'huanqiuti', 'shenxing', 'yunjiexian', 'edgenova', 'breezenet', 'civet'];
if (dualIspIds.includes(airport.id) || (airport.badge && airport.badge.includes('ISP')) || airport.slogan.includes('原生') || (airport.lines && airport.lines.includes('原生'))) {
  categories.push('dual-isp');
}

// 7. gaming (游戏电竞)
const gamingIds = ['invisible', 'dalaocloud', 'sujie', 'shenxing', 'shandianshu', 'huanqiuti', 'yunjiexian', 'laddercloud', 'lightspeed', 'breezenet', 'firefly'];
if (gamingIds.includes(airport.id) || (airport.speed && airport.speed.includes('2.5Gbps')) || airport.slogan.includes('低丢包') || airport.slogan.includes('极速') || airport.slogan.includes('游戏')) {
  categories.push('gaming');
}

const categoriesStr = categories.join(' ');
---

<div
  data-airport-card
  data-name={airport.name.toLowerCase()}
  data-slogan={airport.slogan.toLowerCase()}
  data-category={airport.category || 'cost-effective'}
  data-categories={categoriesStr}
  data-original-index={index}
  class="glass-card rounded-2xl p-4 sm:p-5 relative transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col justify-between bg-white border border-slate-200/90 group"
>
  <!-- Top: Title, Score, Slogan -->
  <div>
    <div class="flex items-start justify-between gap-2 mb-2.5">
      <div class="min-w-0 flex-1">
        <div class="flex items-center space-x-2 flex-wrap gap-y-1">
          <a href={`/airports/${airport.id}`} class="flex items-center space-x-1.5 group/link truncate">
            {airport.logo ? (
              <img
                src={airport.logo}
                alt={airport.name}
                class="w-7 h-7 rounded-lg object-contain bg-slate-50 border border-slate-200/80 flex-shrink-0 group-hover/link:border-indigo-400 transition-colors"
                loading="lazy"
              />
            ) : (
              <span class="flex items-center justify-center w-6 h-6 rounded bg-slate-100 text-[10px] font-mono font-bold text-slate-500 flex-shrink-0">
                #{index + 1}
              </span>
            )}
            <h3 class="text-base font-bold text-slate-900 tracking-tight truncate max-w-[130px] group-hover/link:text-indigo-600 transition-colors" title={airport.name}>
              {airport.name}
            </h3>
          </a>
        </div>
        {airport.badge && (
          <div class="mt-1">
            <span class={`inline-block text-[10px] font-semibold px-2 py-0.5 rounded-full border ${currentBadgeColor}`}>
              {airport.badge}
            </span>
          </div>
        )}
      </div>

      <!-- Rating score -->
      <div class="flex items-baseline space-x-0.5 bg-gradient-to-br from-amber-400 to-amber-500 text-slate-950 font-black px-2 py-0.5 rounded-lg shadow-sm flex-shrink-0">
        <span class="text-[10px]">★</span>
        <span class="text-xs sm:text-sm">{airport.score.toFixed(1)}</span>
      </div>
    </div>

    <!-- Slogan -->
    <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-3.5 min-h-[32px]" title={airport.slogan || '暂无标语'}>
      {airport.slogan || <span class="text-slate-400 italic">暂未收录官方标语</span>}
    </p>

    <!-- Specs Compact Box -->
    <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100 mb-3 text-xs space-y-1.5">
      <div class="flex items-center justify-between">
        <span class="text-[11px] text-slate-400">资费价格</span>
        <span class={`text-xs sm:text-sm ${airport.price !== '-' ? 'font-bold text-indigo-600' : 'font-medium text-slate-400'}`}>
          {airport.price !== '-' ? airport.price : '暂未收录'}
        </span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-[11px] text-slate-400">流量额度</span>
        <span class="font-semibold text-slate-700 text-[11px] truncate max-w-[120px]">
          {airport.traffic !== '-' ? airport.traffic : '暂未收录'}
        </span>
      </div>
      <div class="flex items-center justify-between">
        <span class="text-[11px] text-slate-400">线路类型</span>
        <span class="font-semibold text-emerald-600 text-[11px] truncate max-w-[120px]">
          {airport.lines !== '-' ? airport.lines : '暂未收录'}
        </span>
      </div>
    </div>

    <!-- Unblocks & Features tags -->
    <div class="mb-4">
      <div class="flex flex-wrap gap-1">
        {airport.streaming.slice(0, 3).map(service => (
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-mono">
            {service}
          </span>
        ))}
        {airport.protocols.slice(0, 2).map(p => (
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-600 border border-indigo-100 font-mono">
            {p}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom CTA & Coupon -->
  <div>
    {airport.coupon && (
      <div class="mb-2.5 p-1.5 rounded-lg bg-amber-50 border border-amber-200/80 flex items-center justify-between text-[11px]">
        <span class="font-mono font-bold text-amber-900 bg-white px-1.5 py-0.5 rounded border border-amber-200 text-[10px]">
          {airport.coupon}
        </span>
        <button
          onclick={`copyCoupon('${airport.coupon}', event)`}
          class="px-2 py-0.5 rounded bg-amber-500 hover:bg-amber-600 text-white font-bold text-[10px] transition-colors"
        >
          复制券
        </button>
      </div>
    )}

    <div class="flex items-center gap-1.5">
      <a
        href={`/airports/${airport.id}`}
        class="py-2 px-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-center text-xs transition-colors flex-shrink-0"
        title="查看详细评测"
      >
        详情
      </a>
      <a
        href={airport.affLink}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 py-2 px-3 rounded-xl bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-600 text-white font-bold text-center text-xs shadow-xs hover:shadow active:scale-[0.98] transition-all flex items-center justify-center space-x-1"
      >
        <span>直达官网</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </div>
</div>
